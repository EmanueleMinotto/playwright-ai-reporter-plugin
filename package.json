{
  "name": "playwright-ai-reporter-plugin",
  "version": "0.1.0",
  "description": "Playwright reporter that attaches AI-generated hypotheses about why a test failed, ranked by likelihood, each justified and with a suggested fix",
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "ai",
    "llm",
    "ollama",
    "claude",
    "openai",
    "mcp",
    "reporter",
    "failure-analysis",
    "plugin"
  ],
  "license": "MIT",
  "author": "Emanuele Minotto",
  "repository": {
    "type": "git",
    "url": "https://github.com/EmanueleMinotto/playwright-ai-reporter-plugin"
  },
  "homepage": "https://github.com/EmanueleMinotto/playwright-ai-reporter-plugin#readme",
  "bugs": {
    "url": "https://github.com/EmanueleMinotto/playwright-ai-reporter-plugin/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "require": "./dist/reporter.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @intentional-failure",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0"
  }
}
